{
  "name": "Crowdlog Monthly Reporting",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start-web.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Crowdlog Monthly Report",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  }
}
